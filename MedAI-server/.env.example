# MedAI Server Environment Variables
# Copy this file to .env and fill in your values

# ======================
# LLM Configuration
# ======================
# Primary: Google Gemini (recommended - has free tier)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative key name
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: OpenAI GPT-4 Vision
# OPENAI_API_KEY=your_openai_api_key_here

# ======================
# MedAI Agent (batch-orchestration chat harness, `ai` profile)
# ======================
# Anthropic Claude API key powering the Agent window's tool-use loop.
# Required for the /agent endpoints on the chat service.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model the agent uses (must be accessible to your API key)
# AGENT_MODEL=claude-sonnet-5

# LLM Provider selection (auto-detected if not set)
# LLM_PROVIDER=gemini  # or openai

# LLM Model override (uses provider defaults if not set)
# LLM_MODEL=models/gemini-2.5-flash

# LLM Parameters
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.3

# ======================
# MONAI Label Settings
# ======================
MONAI_LABEL_API_STR=""
MONAI_LABEL_PROJECT_NAME="MedAI MONAI Label"
MONAI_LABEL_AUTH_ENABLE=false
MONAI_LABEL_CORS_ORIGINS=*

# ======================
# Service URLs (for inter-service communication)
# ======================
# These are set automatically in docker-compose but can be overridden
# INFERENCE_SERVICE_URL=http://inference:8001
# VLM_SERVICE_URL=http://vlm:8002
# LLM_SERVICE_URL=http://llm:8003

# ======================
# GPU Configuration
# ======================
CUDA_VISIBLE_DEVICES=0

# ======================
# Model directories (used by the `ai` compose profile)
# ======================
# Host directory holding downloaded model weights (e.g. medgemma-4b-it/)
MODELS_DIR=./models
# Host directory used as the shared HuggingFace / torch cache
MODEL_CACHE_DIR=./model-cache
# HuggingFace token for gated model downloads (optional)
# HF_TOKEN=hf_xxx

# ======================
# Orthanc PACS
# ======================
# The viewer talks to Orthanc via the Vite dev proxy; these are only needed
# if you enable Orthanc authentication (see orthanc/orthanc.json).
# ORTHANC_URL=http://orthanc:8042
# ORTHANC_USERNAME=orthanc
# ORTHANC_PASSWORD=changeme

# ======================
# Cloud Batch Backend - Google Vertex AI (`vertex` compose profile)
# ======================
# Run automated batch segmentation on Vertex AI instead of a local GPU. See
# scripts/vertex/README.md to provision the project, bucket, and worker image.
#
# Backend selector: `local` runs in-process on the GPU inference container;
# `vertex` dispatches to Vertex AI. Can also be set per-job via options.backend.
BATCH_BACKEND=vertex
# Point the Agent (chat service) at the CPU orchestrator in cloud mode.
MONAI_LABEL_SERVER_URL=http://orchestrator:8001

# GCP project + region (region must have T4/L4 GPU quota for Vertex)
GCP_PROJECT=
GCP_REGION=us-central1
# GCS staging bucket (regional, same region as Vertex). Name only, no gs://
GCS_BUCKET=medai-vertex-staging-<project>
# Worker image in Artifact Registry (built by scripts/vertex/02_build_push.sh)
VERTEX_AR_IMAGE=us-central1-docker.pkg.dev/<project>/medai/inference-vertex:latest
# Vertex Custom Job machine + accelerator
VERTEX_MACHINE_TYPE=n1-standard-8
VERTEX_ACCELERATOR_TYPE=NVIDIA_TESLA_T4
VERTEX_ACCELERATOR_COUNT=1
# Runtime service account for the Vertex job (created by scripts/vertex/01_bootstrap.sh)
VERTEX_SERVICE_ACCOUNT=vertex-runner@<project>.iam.gserviceaccount.com
# Models available on the cloud backend (validated at job submission)
VERTEX_MODELS=biomedparse,totalsegmentator,breast_tumor
# Orchestrator poll interval (seconds) while a Vertex job runs
CLOUD_BATCH_POLL_INTERVAL=10

# Service-account key mounted into the orchestrator for GCP auth.
# Host path (compose mounts it read-only at /secrets/gcp-sa.json).
GCP_SA_KEY_FILE=./secrets/gcp-sa.json
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
