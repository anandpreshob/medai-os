  "SaveJobs": true,
  "OverwriteInstances": true,
  "MediaArchiveSize": 1,
  "StorageAccessOnFind": "Always",
  "MetricsEnabled": true,

  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado",
    "Host": "0.0.0.0",
    "Ssl": false,
    "StowMaxInstances": 10,
    "StowMaxSize": 100,
    "QidoCaseSensitive": false,
    "MetadataWorkerThreadsCount": 4,
    "StudiesMetadata": "Full",
    "SeriesMetadata": "Full"
