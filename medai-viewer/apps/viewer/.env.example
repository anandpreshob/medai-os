# Copy this file to .env.local and set your values.
# With no values set, the viewer runs in basic mode (local files + Orthanc/DICOMweb
# viewing + measurement tools) against localhost defaults.

# ---------------------------------------------------------------------------
# Optional features
# ---------------------------------------------------------------------------
# Comma-separated list of optional features to enable (or "all"). Leave empty
# for the basic viewer. Each feature also needs its backend server URL below
# and the matching docker-compose profile running (see MedAI-server).
#   monai-segmentation | chat | chestxray | triage | analytics
#   audit | batch | reports | registration
# Example: VITE_FEATURES=monai-segmentation,analytics
VITE_FEATURES=

# ---------------------------------------------------------------------------
# Backend server URLs
# ---------------------------------------------------------------------------
# MONAI Label server (segmentation, analytics). Default: http://localhost:8002
VITE_MONAI_SERVER_URL=http://localhost:8002

# MedAI API gateway (chat, chest X-ray, triage, batch, reports).
# Default: http://localhost:8002
VITE_MEDAI_SERVER_URL=http://localhost:8002

# Chat service override (falls back to VITE_MEDAI_SERVER_URL if unset).
# VITE_CHAT_SERVICE_URL=http://localhost:8002

# Orthanc PACS (dev-proxy target for /proxy/dicom and /proxy/orthanc).
# Default: http://localhost:8042
VITE_ORTHANC_URL=http://localhost:8042
